# 구글 클라우드 > API 및 서비스 > 사용자 인증 정보 에서 만든 값 (공개돼도 되는 값)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
# 구글 클라우드 프로젝트 번호 (Picker 용)
NEXT_PUBLIC_GOOGLE_APP_ID=
# 로그인 서버 (서버 전용 비밀 값, NEXT_PUBLIC 을 붙이지 않는다). 비워 두면 팝업 로그인
# 구글 클라우드 > 클라이언트 > 가계부 웹 > 클라이언트 보안 비밀번호
GOOGLE_CLIENT_SECRET=
# 쿠키 암호화 키: openssl rand -base64 32
AUTH_COOKIE_SECRET=
